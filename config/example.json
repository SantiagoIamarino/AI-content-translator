{
  "executables": {
    "python_qwen": "python3",
    "whisper": "/path/to/whisper/.venv/bin/whisper",
    "ffmpeg": "/usr/bin/ffmpeg",
    "ffprobe": "/usr/bin/ffprobe"
  },
  "jobs_dir": "jobs",
  "audio_mapping": {
    "mic_ordinal": 2,
    "game_ordinal": 1,
    "mixed_ordinal": 0,
    "note": "Placeholders. Ordinals count audio streams in container order. They are not absolute stream indices. Identify them per recording; do not assume these numbers."
  },
  "whisper": {
    "model": "turbo",
    "language": "Spanish",
    "task": "transcribe",
    "device": "cuda",
    "word_timestamps": true,
    "output_format": "json",
    "verbose": false
  },
  "qwen3": {
    "model_id": "Qwen/Qwen3-TTS-12Hz-1.7B-Base",
    "attn_implementation": "sdpa",
    "dtype": "bfloat16",
    "device": "cuda:0",
    "language": "English",
    "x_vector_only_mode": false,
    "generation": {
      "do_sample": true,
      "top_k": 50,
      "top_p": 1.0,
      "temperature": 0.9,
      "repetition_penalty": 1.05,
      "subtalker_dosample": true,
      "subtalker_top_k": 50,
      "subtalker_top_p": 1.0,
      "subtalker_temperature": 0.9,
      "max_new_tokens": 2048
    }
  },
  "reference": {
    "id": "B",
    "wav": "/path/to/voice-reference.wav",
    "text_file": "references/reference_b.txt",
    "note": "The wav is not in Git. text_file must match the transcript locked in aidub/config.py unless that check is changed."
  },
  "schedule": {
    "seed_base": 42,
    "alternate_seed_offset": 100,
    "max_tempo": 1.1,
    "min_tempo": 1.0,
    "trim_rms": 0.005,
    "trim_window_sec": 0.01,
    "trim_pad_ms": 0,
    "fade_ms": 5,
    "output_sr": 48000
  },
  "repair": {
    "max_alternate_synthesis": 1,
    "max_compact_revisions": 1
  },
  "quality": {
    "max_retries": 2,
    "min_speaker_features": 2,
    "checker": "f0-and-centroid-v3",
    "asr_device": "cpu",
    "asr_language": "",
    "speaker_proxy_enabled": true,
    "asr_model": "turbo",
    "asr_model_path": ""
  },
  "fit_retries": {
    "max_alternate_seeds": 3,
    "max_leading_shift_sec": 0.4
  },
  "voice_edge": {
    "enabled": true,
    "margin_lead_ms": 20,
    "margin_tail_ms": 60,
    "fade_ms": 12
  },
  "unattended": {
    "enabled": false,
    "max_shorter_translations": 2
  },
  "providers": {
    "translation": {
      "kind": "unconfigured"
    },
    "repair": {
      "kind": "unconfigured"
    }
  },
  "mix": {
    "limiter": 0.99,
    "headroom_policy": "partial",
    "min_voice_gain": 0.1
  },
  "segmentation": {
    "energy_rms": 0.005,
    "energy_window_sec": 0.01,
    "onset_lookback_sec": 0.5,
    "end_tail_sec": 0.2,
    "merge_max_silence_sec": 0.12,
    "min_voiced_sec": 0.04,
    "uncertain_probability": 0.5,
    "quiet_speech_heuristic": true,
    "untranscribed_energy_policy": "partial"
  },
  "docker_llm_container": "unused-do-not-start",
  "models": {
    "qwen_path": "",
    "whisper_path": ""
  },
  "batching": {
    "max_cues": 40,
    "max_chars": 24000
  },
  "transcription": {
    "chunk_sec": 600,
    "overlap_sec": 2
  },
  "timeouts": {
    "worker_startup_sec": 180,
    "asr_candidate_sec": 180,
    "asr_chunk_sec": 1800,
    "media_sec": 10800,
    "probe_sec": 1200,
    "tempo_sec": 180
  },
  "processing": {
    "block_frames": 65536
  },
  "export": {
    "container": "mp4"
  }
}
